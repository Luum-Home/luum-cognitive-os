# =============================================================================
# Cognitive OS — .gitignore
# =============================================================================

# ── Cognitive OS runtime (generated during sessions, never committed) ────────
.cognitive-os/
!.cognitive-os/
.cognitive-os/*
!.cognitive-os/plans/
!.cognitive-os/plans/*/
!.cognitive-os/plans/*/.gitkeep
!.cognitive-os/reports/
.cognitive-os/reports/*
!.cognitive-os/reports/research/
!.cognitive-os/reports/research/.gitkeep
!.cognitive-os/skills/
.cognitive-os/skills/*
!.cognitive-os/skills/_catalog-allowlist.txt
!.cognitive-os/preserve-manifests/
!.cognitive-os/preserve-manifests/*.json
!.cognitive-os/test-quarantine.yaml
# SDD archive trail is tracked, in-flight changes stay local (override .cognitive-os/* ignore)
!.cognitive-os/sdd/
.cognitive-os/sdd/*
!.cognitive-os/sdd/changes/
.cognitive-os/sdd/changes/*
!.cognitive-os/sdd/changes/archive/
!.cognitive-os/sdd/changes/archive/**
dynamic-tools/
sessions/
transcripts/
checkpoints/*.json
!checkpoints/.gitkeep
tasks/active-tasks.json
tasks/.active-tasks.lock
!tasks/.gitkeep

# Metrics (append-only files generated by hooks)
metrics/*.jsonl
!metrics/.gitkeep

# Auto-generated skills (session-scoped)
skills/auto-generated/

# Runtime state
.last-sync
rate-limit-state.json

# ── Compiled Go binaries + SQLite scratch (build artifacts) ──────────────────
/cos-dispatch
*.exe
*.test
*.db
*.db-journal

# ── Plugin runtime data ─────────────────────────────────────────────────────
.claude/plugins/.cognitive-os/

# ── Harness-installed skills (symlinks generated by self-install.sh) ─────────
# Populated by `bash hooks/self-install.sh` from skills/ — same pattern as
# .cognitive-os/skills/. Not committed; installer is source of truth.
.claude/skills/*
!.claude/skills/install-skill
!.claude/skills/install-hook
# Same class, same reason: cos_init.py projects the codex harness into
# .agents/skills as symlinks back into .cognitive-os/skills/cos. It was missing
# from this list, so it sat untracked-and-unignored and read as an oversight
# rather than the policy it is. What is on disk here predates the symlink
# projection — real copied directories from 2026-07-30 — and the installer no
# longer produces that shape, so it is stale in a format nothing regenerates.
.agents/skills/*

# ── Claude Code local settings (machine-specific, not shared) ───────────────
.claude/settings.local.json
.claude/*.lock

# ── Environment & secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*
!.env.example
*.pem
*.key
infra/seaweedfs/s3.json

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
.report.json

# ── Go ──────────────────────────────────────────────────────────────────────
cmd/cos/cos
cmd/cos-test/cos-test
cmd/cos-test/.cognitive-os/

# ── Node.js ─────────────────────────────────────────────────────────────────
node_modules/

# ── Tool caches ─────────────────────────────────────────────────────────────
.promptfoo/
.devbox/

# ── Reference repos (cloned for study, not part of Cognitive OS) ────────────
reference/

# ── OS & editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.bak
*.log
*.swp
*~
mutants/
# `conftest.py` pelado vivia aca, entre los artefactos de mutacion, e
# ignoraba TODO conftest en cualquier nivel del arbol — incluido el de la
# raiz y el de packages/agent-service/tests/. Los 8 que estan trackeados
# entraron con `add -f`, o sea que el sintoma se venia pagando caso por
# caso. `mutants/` de arriba ya cubre lo que la linea queria cubrir.
cos_mutation.sqlite
.claude/worktrees/

# Cognitive OS local memory exports (may contain private absolute paths)
.engram/exports/*.jsonl
/cos-test

# ADR-176: SkillStore SQLite DB (binary; not tracked)
.cognitive-os/skill_store.db

# Cognitive OS runtime coordination state (local, append-only, may contain paths)
.cognitive-os/runtime/
.cognitive-os/sessions/*.jsonl
.cognitive-os/sessions/*.lock
.cognitive-os/sessions/events-archive/
.cognitive-os/coordination/*.jsonl
.cognitive-os/coordination/*.lock
.cognitive-os/coordination/agent-messages-archive/
.cognitive-os/metrics/context-budget.jsonl

# ADR-255: external source snapshots for due diligence, never tracked
.cognitive-os/external-source-cache/
.cognitive-os/private/
.private/

# Rust build output
target/
graphify-out/

# Artefactos derivados de los auditores: salida de build, no fuente.
#
# Medido el 2026-08-22: 41 archivos `-latest.json` sumaban 1.813.462 lineas,
# el 52,9% del repositorio ENTERO. Uno solo --primitive-harness-coverage--
# eran 1.358.284, o sea el 68,7% de todos los informes.
#
# Los regenera su script (acc_pipeline.py, cos-weekly-primitive-gap.sh,
# script_exposure_audit.py, dogfood_scorer.py). Versionar salida de build
# infla cada clone, cada diff y cada ventana de contexto de un agente, y no
# aporta nada que el generador no reponga en una corrida.
#
# El resumen legible SI se versiona: los 41 `-latest.md` que los acompañan
# suman 14.116 lineas -- 128 veces menos-- y son lo que una persona lee.
docs/06-Daily/reports/*-latest.json
