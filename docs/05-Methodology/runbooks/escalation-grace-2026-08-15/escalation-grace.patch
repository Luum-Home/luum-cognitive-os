new file mode 100644
index 0000000..6910b2b
--- /dev/null
+++ b/tests/contracts/test_subagent_budget_escalation_grace.py
@@ -0,0 +1,259 @@
+# SCOPE: both
+"""The `ESCALATION:` pass is a one-time, pre-sized, consumed grace.
+
+Why this file exists
+--------------------
+`hooks/subagent-budget-enforcer.sh` used to test the whole payload for the
+substring `ESCALATION:` *before* comparing the count to the budget. Any
+subagent that wrote that string anywhere — including in a report *about*
+escalation — reopened its own budget, once per call, forever.
+
+Measured on `.cognitive-os/metrics/subagent-budget-enforcer.jsonl` at
+2026-08-15 (732 rows):
+
+* 57 uses of the pass; 18 of them fired *below* the budget, where there was
+  nothing to authorize;
+* one subagent (`a632278962fd85ae2`) used it 43 times, absorbed 7 blocks in
+  the gaps where it happened not to write the string, and reached 96 tool
+  calls against a budget of 50.
+
+That is not an implementation bug. The authorization channel and the content
+channel were the same channel, so no pattern can separate "I declare I am
+stuck" from "my text contains a word". A token the agent can emit is not an
+authorization; it is a vocabulary item, and a model that wants to keep working
+will produce it.
+
+The contract these tests fix
+----------------------------
+The string no longer grants budget. It *triggers* a grace that is:
+
+* granted at most once per ``(session_id, agent_id)``,
+* pre-sized (``COS_SUBAGENT_ESCALATION_GRACE``, default 5),
+* consumed by call count, not by what the payload says,
+* recorded in the hook's own ledger with an explicit ``grace_until``.
+
+Sizing rationale lives in
+``docs/06-Daily/reports/escalation-bypass-close-2026-08-15.md``: the grace is
+dimensioned to *close* (persist state, hand off a report), never to continue.
+
+These tests are mode-agnostic on purpose. They constrain the authorization
+decision only, so they stay valid across the ADR-311 PostToolUse/PreToolUse
+split described in
+``docs/06-Daily/reports/subagent-budget-enforcer-architecture-2026-08-15.md``.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.contract
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+HOOK = REPO_ROOT / "hooks" / "subagent-budget-enforcer.sh"
+
+BUDGET = 2
+GRACE = 3
+
+
+def _run(
+    tmp_path: Path,
+    command: str = "echo ok",
+    env_extra: dict[str, str] | None = None,
+    agent_id: str = "agent-a",
+) -> subprocess.CompletedProcess[str]:
+    env = os.environ.copy()
+    env.update(
+        {
+            "COGNITIVE_OS_PROJECT_DIR": str(tmp_path),
+            "COGNITIVE_OS_SESSION_ID": "session-a",
+            "COGNITIVE_OS_SESSION_KIND": "subagent",
+            "COGNITIVE_OS_HOOK_AGENT_ID": agent_id,
+            "COS_SUBAGENT_TOOL_CALL_BUDGET": str(BUDGET),
+            "COS_SUBAGENT_ESCALATION_GRACE": str(GRACE),
+            "COS_ALLOW_SUBAGENT_BUDGET_BYPASS": "0",
+            "COS_SUBAGENT_BUDGET_BYPASS_REASON": "",
+        }
+    )
+    if env_extra:
+        env.update(env_extra)
+    payload = {"tool_name": "Bash", "tool_input": {"command": command}}
+    return subprocess.run(
+        ["bash", str(HOOK)],
+        input=json.dumps(payload),
+        text=True,
+        capture_output=True,
+        cwd=tmp_path,
+        env=env,
+        timeout=20,
+        check=False,
+    )
+
+
+def _declare(tmp_path: Path, **kwargs) -> subprocess.CompletedProcess[str]:
+    """A call whose payload carries the escalation token."""
+    return _run(tmp_path, "printf 'ESCALATION: stuck, handing off'", **kwargs)
+
+
+def _ledger(tmp_path: Path) -> list[dict]:
+    path = tmp_path / ".cognitive-os" / "metrics" / "subagent-budget-enforcer.jsonl"
+    if not path.exists():
+        return []
+    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
+
+
+def _spend_budget(tmp_path: Path, agent_id: str = "agent-a") -> None:
+    for _ in range(BUDGET):
+        assert _run(tmp_path, agent_id=agent_id).returncode == 0
+
+
+# ── the hole this file closes ───────────────────────────────────────────────
+
+
+def test_second_declaration_over_budget_opens_nothing(tmp_path: Path) -> None:
+    """The missing case. One grant, then the token is inert.
+
+    With GRACE=3 the grant covers calls N..N+2. The fourth over-budget call is
+    blocked no matter how well-formed its declaration is.
+    """
+    _spend_budget(tmp_path)
+
+    first = _declare(tmp_path)
+    assert first.returncode == 0, first.stderr
+    assert "GRACE GRANTED" in first.stderr
+
+    # calls 2 and 3 of the grace: still open, and the token is not what opens
+    # them — the count is.
+    assert _run(tmp_path).returncode == 0
+    assert _run(tmp_path).returncode == 0
+
+    exhausted = _declare(tmp_path)
+    assert exhausted.returncode == 2, (
+        "a second declaration must not reopen the budget; "
+        f"got rc={exhausted.returncode} stderr={exhausted.stderr!r}"
+    )
+    assert "grants nothing" in exhausted.stderr
+
+    reasons = [row["reason"] for row in _ledger(tmp_path)]
+    assert reasons.count("escalation_grace_granted") == 1, reasons
+    assert "escalation_grace_exhausted" in reasons
+
+
+def test_repeated_declarations_never_exceed_the_pre_sized_grace(tmp_path: Path) -> None:
+    """The 96-call regression, in miniature.
+
+    Ten consecutive declarations must buy exactly GRACE calls, not ten.
+    """
+    _spend_budget(tmp_path)
+
+    allowed = sum(1 for _ in range(10) if _declare(tmp_path).returncode == 0)
+
+    assert allowed == GRACE, f"expected exactly {GRACE} allowed calls, got {allowed}"
+
+
+def test_grace_is_granted_once_and_recorded_with_its_bound(tmp_path: Path) -> None:
+    _spend_budget(tmp_path)
+    _declare(tmp_path)
+
+    grants = [r for r in _ledger(tmp_path) if r["reason"] == "escalation_grace_granted"]
+    assert len(grants) == 1, grants
+    grant = grants[0]
+    assert grant["action"] == "allow"
+    assert grant["grace_until"] == grant["tool_calls"] + GRACE - 1
+    assert grant["agent_id"] == "agent-a"
+
+
+def test_declaration_below_budget_authorizes_nothing_and_burns_no_grace(
+    tmp_path: Path,
+) -> None:
+    """18 of the 57 historical uses fired here, on agents merely writing prose.
+
+    Below the budget there is nothing to authorize, so the token must be inert
+    *and* must not consume the close-out grace the agent may still need.
+    """
+    assert _declare(tmp_path).returncode == 0
+
+    reasons = [row["reason"] for row in _ledger(tmp_path)]
+    assert "escalation_grace_granted" not in reasons, reasons
+
+    # budget still intact: the second call warns, the third gets the grant.
+    assert _run(tmp_path).returncode == 0
+    third = _declare(tmp_path)
+    assert third.returncode == 0
+    assert "GRACE GRANTED" in third.stderr
+
+
+def test_grace_is_scoped_per_agent(tmp_path: Path) -> None:
+    """One agent burning its grace must not close the exit for another."""
+    _spend_budget(tmp_path, agent_id="agent-a")
+    for _ in range(GRACE):
+        _declare(tmp_path, agent_id="agent-a")
+    assert _declare(tmp_path, agent_id="agent-a").returncode == 2
+
+    _spend_budget(tmp_path, agent_id="agent-b")
+    assert _declare(tmp_path, agent_id="agent-b").returncode == 0
+
+
+def test_plain_block_still_names_the_grace_it_offers(tmp_path: Path) -> None:
+    """Over budget without a declaration: blocked, and told the exit exists."""
+    _spend_budget(tmp_path)
+
+    blocked = _run(tmp_path)
+
+    assert blocked.returncode == 2
+    assert "BLOCK" in blocked.stderr
+    assert "ESCALATION:" in blocked.stderr
+    assert [r["reason"] for r in _ledger(tmp_path)][-1] == "budget_exceeded"
+
+
+# ── the channel that must survive: harness environment ──────────────────────
+
+
+def test_operator_bypass_still_works_after_the_grace_is_exhausted(
+    tmp_path: Path,
+) -> None:
+    """The env var is unreachable from the agent's tool input. It stays whole.
+
+    This is the model the fix preserves: authorization arrives on a channel the
+    governed party cannot write to.
+    """
+    _spend_budget(tmp_path)
+    for _ in range(GRACE):
+        _declare(tmp_path)
+    assert _declare(tmp_path).returncode == 2
+
+    allowed = _run(
+        tmp_path,
+        env_extra={
+            "COS_ALLOW_SUBAGENT_BUDGET_BYPASS": "1",
+            "COS_SUBAGENT_BUDGET_BYPASS_REASON": "operator extended the sweep",
+        },
+    )
+
+    assert allowed.returncode == 0, allowed.stderr
+    assert any("bypass:" in r["reason"] for r in _ledger(tmp_path))
+
+
+def test_bypass_is_checked_before_the_payload_is_trusted(tmp_path: Path) -> None:
+    """Ordering guard: the operator channel is evaluated first, always.
+
+    An empty reason must block even when the payload declares escalation — the
+    payload cannot rescue a malformed operator bypass.
+    """
+    _spend_budget(tmp_path)
+
+    result = _declare(
+        tmp_path,
+        env_extra={
+            "COS_ALLOW_SUBAGENT_BUDGET_BYPASS": "1",
+            "COS_SUBAGENT_BUDGET_BYPASS_REASON": "",
+        },
+    )
+
+    assert result.returncode == 2
+    assert "COS_SUBAGENT_BUDGET_BYPASS_REASON" in result.stderr
+    assert [r["reason"] for r in _ledger(tmp_path)][-1] == "missing_bypass_reason"
