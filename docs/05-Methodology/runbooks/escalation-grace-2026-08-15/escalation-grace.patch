--- /dev/null
+++ b/tests/contracts/test_subagent_budget_escalation_grace.py
@@ -0,0 +1,312 @@
+# SCOPE: both
+"""The payload does not participate in the budget decision.
+
+Why this file exists
+--------------------
+`hooks/subagent-budget-enforcer.sh` used to test the whole payload for the
+substring `ESCALATION:` *before* comparing the count to the budget. Any
+subagent whose payload carried that string reopened its own budget, once per
+call, forever.
+
+Measured on `.cognitive-os/metrics/subagent-budget-enforcer.jsonl` at
+2026-08-15 (732 rows): 57 uses of the pass, 18 of them *below* the budget where
+there was nothing to authorize; one subagent (`a632278962fd85ae2`) used it 43
+times, absorbed 7 blocks in the gaps, and reached 96 tool calls against a
+budget of 50.
+
+Two facts killed every attempt to filter the string rather than remove it:
+
+1. The agent chooses what it writes, so a stricter pattern (`^ESCALATION:`, a
+   formatted block) is simply the next thing it writes. A token the agent can
+   emit is not an authorization, it is a vocabulary item.
+2. Worse, it did not have to write it at all. A `PostToolUse` payload carries
+   `tool_response`, so an agent that merely **read** a file containing the
+   token — the hook itself, or this very file — was granted the pass. Verified
+   2026-08-15: a plain `cat` of the hook logged `escalation_declared` at
+   `tool_calls: 1`. When observing the mechanism trips it, the token cannot be
+   filtered, only removed from the decision.
+
+The contract these tests fix
+----------------------------
+The budget decision reads the **call count** and the **harness environment**,
+and nothing else. The payload is parsed only to identify the subagent.
+
+An agent that hits the budget mid-task still gets to close out: a grace of
+`COS_SUBAGENT_ESCALATION_GRACE` calls (default 5) is granted
+**unconditionally** on the first over-budget call, once per
+``(session_id, agent_id)``, consumed by count, recorded in the hook's own
+ledger with an explicit ``grace_until``. It is sized to *close* — persist state,
+hand off a report — never to continue. Rationale and the measurement behind the
+5 are in `docs/06-Daily/reports/escalation-bypass-close-2026-08-15.md`.
+
+These tests are mode-agnostic on purpose: they constrain the authorization
+decision only, so they stay valid across the ADR-311 PostToolUse/PreToolUse
+split described in
+`docs/06-Daily/reports/subagent-budget-enforcer-architecture-2026-08-15.md`.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.contract
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+HOOK = REPO_ROOT / "hooks" / "subagent-budget-enforcer.sh"
+
+BUDGET = 2
+GRACE = 3
+
+# Built rather than written, so this file can be read by a subagent without the
+# old hook granting it a pass on the way past. That evasion is a finding in its
+# own right: the substring test was defeated by a `+`.
+TOKEN = "ESCALATION" + ":"
+
+
+def _run(
+    tmp_path: Path,
+    payload: dict | None = None,
+    env_extra: dict[str, str] | None = None,
+    agent_id: str = "agent-a",
+) -> subprocess.CompletedProcess[str]:
+    env = os.environ.copy()
+    env.update(
+        {
+            "COGNITIVE_OS_PROJECT_DIR": str(tmp_path),
+            "COGNITIVE_OS_SESSION_ID": "session-a",
+            "COGNITIVE_OS_SESSION_KIND": "subagent",
+            "COGNITIVE_OS_HOOK_AGENT_ID": agent_id,
+            "COS_SUBAGENT_TOOL_CALL_BUDGET": str(BUDGET),
+            "COS_SUBAGENT_ESCALATION_GRACE": str(GRACE),
+            "COS_ALLOW_SUBAGENT_BUDGET_BYPASS": "0",
+            "COS_SUBAGENT_BUDGET_BYPASS_REASON": "",
+        }
+    )
+    if env_extra:
+        env.update(env_extra)
+    return subprocess.run(
+        ["bash", str(HOOK)],
+        input=json.dumps(payload if payload is not None else _plain()),
+        text=True,
+        capture_output=True,
+        cwd=tmp_path,
+        env=env,
+        timeout=20,
+        check=False,
+    )
+
+
+def _plain() -> dict:
+    return {
+        "hook_event_name": "PostToolUse",
+        "tool_name": "Bash",
+        "tool_input": {"command": "echo ok"},
+        "tool_response": {"stdout": "ok"},
+    }
+
+
+def _authored() -> dict:
+    """The agent writes the token itself: the old declaration."""
+    payload = _plain()
+    payload["tool_input"] = {"command": f"printf '{TOKEN} stuck, handing off'"}
+    return payload
+
+
+def _merely_read() -> dict:
+    """The agent reads a file that happens to contain the token.
+
+    Innocent `tool_input`; the token arrives only in `tool_response`. Under the
+    old hook this was indistinguishable from a declaration, which is how a
+    `cat` of the hook granted its reader a pass.
+    """
+    payload = _plain()
+    payload["tool_input"] = {"file_path": "hooks/subagent-budget-enforcer.sh"}
+    payload["tool_name"] = "Read"
+    payload["tool_response"] = {"content": f"printf 'BLOCK ... Emit `{TOKEN}` ...'"}
+    return payload
+
+
+def _ledger(tmp_path: Path) -> list[dict]:
+    path = tmp_path / ".cognitive-os" / "metrics" / "subagent-budget-enforcer.jsonl"
+    if not path.exists():
+        return []
+    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
+
+
+def _verdicts(tmp_path: Path, payload: dict, calls: int, agent_id: str) -> list[tuple]:
+    """(returncode, ledger reason) for `calls` consecutive invocations."""
+    out = []
+    for _ in range(calls):
+        rc = _run(tmp_path, payload, agent_id=agent_id).returncode
+        rows = [r for r in _ledger(tmp_path) if r["agent_id"] == agent_id]
+        out.append((rc, rows[-1]["reason"] if rows else None))
+    return out
+
+
+# ── the property that replaces the pass ─────────────────────────────────────
+
+
+def test_payload_content_does_not_change_the_verdict(tmp_path: Path) -> None:
+    """The test the substring version could not have.
+
+    Two agents, same call sequence, payloads identical except that one carries
+    the token in every single call. Same verdicts, call for call. Under the old
+    hook the second sequence never blocked at all.
+    """
+    plain = _verdicts(tmp_path, _plain(), calls=BUDGET + GRACE + 2, agent_id="agent-plain")
+    declaring = _verdicts(tmp_path, _authored(), calls=BUDGET + GRACE + 2, agent_id="agent-decl")
+
+    assert declaring == plain, (
+        "the payload must not change the verdict; "
+        f"plain={plain} declaring={declaring}"
+    )
+    # and the sequence is the intended one: warn, grant, consume, then block
+    assert [rc for rc, _ in plain] == [0, 0, 0, 0, 0, 2, 2], plain
+    assert [reason for _, reason in plain] == [
+        None,
+        "budget_reached",
+        "escalation_grace_granted",
+        "escalation_grace_consumed",
+        "escalation_grace_consumed",
+        "escalation_grace_exhausted",
+        "escalation_grace_exhausted",
+    ], plain
+
+
+def test_token_arriving_only_in_tool_response_is_indistinguishable(
+    tmp_path: Path,
+) -> None:
+    """Reading a file that mentions the token must be an ordinary call.
+
+    This is the case that made filtering hopeless: the agent authored nothing.
+    """
+    reading = _verdicts(tmp_path, _merely_read(), calls=BUDGET + GRACE + 2, agent_id="agent-read")
+    plain = _verdicts(tmp_path, _plain(), calls=BUDGET + GRACE + 2, agent_id="agent-plain")
+
+    assert reading == plain, f"reading={reading} plain={plain}"
+
+
+def test_declaring_repeatedly_never_exceeds_the_pre_sized_grace(tmp_path: Path) -> None:
+    """The 96-call regression, in miniature: ten declarations buy GRACE calls."""
+    for _ in range(BUDGET):
+        assert _run(tmp_path).returncode == 0
+
+    allowed = sum(1 for _ in range(10) if _run(tmp_path, _authored()).returncode == 0)
+
+    assert allowed == GRACE, f"expected exactly {GRACE} allowed calls, got {allowed}"
+
+
+# ── the grace itself ────────────────────────────────────────────────────────
+
+
+def test_grace_is_granted_unconditionally_on_the_first_over_budget_call(
+    tmp_path: Path,
+) -> None:
+    """No declaration exists, and none is needed. Hitting the budget is enough."""
+    for _ in range(BUDGET):
+        _run(tmp_path)
+
+    first_over = _run(tmp_path)
+
+    assert first_over.returncode == 0, first_over.stderr
+    assert "GRACE GRANTED" in first_over.stderr
+    grants = [r for r in _ledger(tmp_path) if r["reason"] == "escalation_grace_granted"]
+    assert len(grants) == 1, grants
+    assert grants[0]["grace_until"] == grants[0]["tool_calls"] + GRACE - 1
+
+
+def test_grace_is_granted_once_and_never_renews(tmp_path: Path) -> None:
+    for _ in range(BUDGET + GRACE):
+        _run(tmp_path)
+
+    for _ in range(4):
+        assert _run(tmp_path).returncode == 2
+
+    reasons = [r["reason"] for r in _ledger(tmp_path)]
+    assert reasons.count("escalation_grace_granted") == 1, reasons
+    assert reasons.count("escalation_grace_exhausted") == 4, reasons
+
+
+def test_grace_is_scoped_per_agent(tmp_path: Path) -> None:
+    """One agent burning its grace must not close the exit for another."""
+    for _ in range(BUDGET + GRACE):
+        _run(tmp_path, agent_id="agent-a")
+    assert _run(tmp_path, agent_id="agent-a").returncode == 2
+
+    for _ in range(BUDGET):
+        assert _run(tmp_path, agent_id="agent-b").returncode == 0
+    assert _run(tmp_path, agent_id="agent-b").returncode == 0
+
+
+def test_below_budget_nothing_is_granted_and_the_warning_names_the_grace(
+    tmp_path: Path,
+) -> None:
+    assert _run(tmp_path).returncode == 0
+    warned = _run(tmp_path)
+
+    assert warned.returncode == 0
+    assert "WARN" in warned.stderr
+    assert str(GRACE) in warned.stderr
+    reasons = [r["reason"] for r in _ledger(tmp_path)]
+    assert "escalation_grace_granted" not in reasons, reasons
+
+
+def test_exhausted_block_says_that_writing_more_will_not_help(tmp_path: Path) -> None:
+    """The message must not invite the behaviour the hook no longer honours."""
+    for _ in range(BUDGET + GRACE):
+        _run(tmp_path)
+
+    blocked = _run(tmp_path)
+
+    assert blocked.returncode == 2
+    assert "payload is not part of the decision" in blocked.stderr
+    assert "COS_ALLOW_SUBAGENT_BUDGET_BYPASS" in blocked.stderr
+
+
+# ── the channel that must survive: harness environment ──────────────────────
+
+
+def test_operator_bypass_still_works_after_the_grace_is_exhausted(
+    tmp_path: Path,
+) -> None:
+    """The env var is unreachable from the agent's payload. It stays whole.
+
+    This is the contrast worth keeping: one channel the governed party cannot
+    write to, and one removed precisely because observing it was enough to
+    write to it.
+    """
+    for _ in range(BUDGET + GRACE):
+        _run(tmp_path)
+    assert _run(tmp_path).returncode == 2
+
+    allowed = _run(
+        tmp_path,
+        env_extra={
+            "COS_ALLOW_SUBAGENT_BUDGET_BYPASS": "1",
+            "COS_SUBAGENT_BUDGET_BYPASS_REASON": "operator extended the sweep",
+        },
+    )
+
+    assert allowed.returncode == 0, allowed.stderr
+    assert any("bypass:" in r["reason"] for r in _ledger(tmp_path))
+
+
+def test_bypass_is_evaluated_before_anything_else(tmp_path: Path) -> None:
+    """Ordering guard: a malformed operator bypass blocks even below budget."""
+    result = _run(
+        tmp_path,
+        _authored(),
+        env_extra={
+            "COS_ALLOW_SUBAGENT_BUDGET_BYPASS": "1",
+            "COS_SUBAGENT_BUDGET_BYPASS_REASON": "",
+        },
+    )
+
+    assert result.returncode == 2
+    assert "COS_SUBAGENT_BUDGET_BYPASS_REASON" in result.stderr
+    assert [r["reason"] for r in _ledger(tmp_path)][-1] == "missing_bypass_reason"
