#!/usr/bin/env python3
# SCOPE: both
"""Consumer-project token optimization smoke with normalized real-usage fixtures.

Creates stack-diverse fixture projects (Node, Python, Go), writes paired baseline
and Cognitive OS session JSONL records using provider/harness usage shapes, and
compares normalized real token counters. It never calls a model; the fixtures are
real provider/harness telemetry shapes so the parser/report path is exercised
without making live savings claims.
"""
from __future__ import annotations

import argparse
import json
import tempfile
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
import sys
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from lib.token_usage import summarize_usage_jsonl  # noqa: E402

DEFAULT_ARCHIVE = ROOT / ".cognitive-os" / "metrics" / "token-optimization-consumer-smoke.jsonl"
DEFAULT_REPORT = ROOT / ".cognitive-os" / "reports" / "token-optimization-consumer-smoke.md"

STACKS: tuple[dict[str, Any], ...] = (
    {
        "stack": "node",
        "files": {"package.json": '{"scripts":{"test":"vitest run"}}\n', "src/index.ts": "export const ok = true;\n"},
        "baseline": {"provider": "openai", "harness": "codex", "model": "gpt-5.1", "usage": {"prompt_tokens": 4200, "completion_tokens": 500, "prompt_tokens_details": {"cached_tokens": 200}}},
        "cos": {"provider": "openai", "harness": "codex", "model": "gpt-5.1", "usage": {"prompt_tokens": 2300, "completion_tokens": 420, "prompt_tokens_details": {"cached_tokens": 500}}},
    },
    {
        "stack": "python",
        "files": {"pyproject.toml": "[tool.pytest.ini_options]\n", "app/main.py": "def ok():\n    return True\n"},
        "baseline": {"payload": {"provider": "anthropic", "harness": "opencode", "model": "claude-sonnet-4-6"}, "usage": {"inputTokens": 3800, "outputTokens": 450, "cachedInputTokens": 100}},
        "cos": {"payload": {"provider": "anthropic", "harness": "opencode", "model": "claude-sonnet-4-6"}, "usage": {"inputTokens": 1900, "outputTokens": 390, "cachedInputTokens": 420}},
    },
    {
        "stack": "go",
        "files": {"go.mod": "module example.com/smoke\n", "main.go": "package main\nfunc main(){}\n"},
        "baseline": {"harness": "generic-ide", "model": "local-agent", "usage": {"totalTokens": 3100}},
        "cos": {"harness": "generic-ide", "model": "local-agent", "usage": {"totalTokens": 1800}},
    },
)


@dataclass(frozen=True)
class StackResult:
    stack: str
    provider: str
    harness: str
    baseline_total_tokens: int
    cos_total_tokens: int
    saved_tokens: int
    reduction_percent: float
    telemetry_source: str = "fixture-real-shape"


def _write_jsonl(path: Path, row: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(row, sort_keys=True) + "\n", encoding="utf-8")


def _create_project(root: Path, stack: dict[str, Any]) -> Path:
    project = root / f"consumer-{stack['stack']}"
    project.mkdir(parents=True, exist_ok=True)
    for rel, content in stack["files"].items():
        target = project / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(str(content), encoding="utf-8")
    (project / "AGENTS.md").write_text("# Consumer smoke\nUse the smallest trustworthy context.\n", encoding="utf-8")
    (project / "cognitive-os.yaml").write_text("project:\n  phase: reconstruction\n", encoding="utf-8")
    return project


def _result_for(stack: dict[str, Any], root: Path) -> StackResult:
    _create_project(root, stack)
    traces = root / "traces" / str(stack["stack"])
    baseline_path = traces / "baseline.jsonl"
    cos_path = traces / "cos.jsonl"
    _write_jsonl(baseline_path, stack["baseline"])
    _write_jsonl(cos_path, stack["cos"])
    baseline = summarize_usage_jsonl(baseline_path, default_harness="consumer-smoke")
    cos = summarize_usage_jsonl(cos_path, default_harness="consumer-smoke")
    baseline_total = baseline.total_tokens
    cos_total = cos.total_tokens
    saved = baseline_total - cos_total
    pct = round((saved / baseline_total) * 100, 2) if baseline_total else 0.0
    providers = cos.providers_seen or baseline.providers_seen or ["unknown"]
    harnesses = cos.harnesses_seen or baseline.harnesses_seen or ["unknown"]
    return StackResult(
        stack=str(stack["stack"]),
        provider=providers[0],
        harness=harnesses[0],
        baseline_total_tokens=baseline_total,
        cos_total_tokens=cos_total,
        saved_tokens=saved,
        reduction_percent=pct,
    )


def _render_report(payload: dict[str, Any]) -> str:
    lines = [
        "# Token Optimization Consumer Smoke",
        "",
        f"Generated: {payload['generated_at']}",
        f"Status: `{payload['status']}`",
        f"Threshold: {payload['threshold_percent']}% per stack",
        "",
        "This smoke compares vanilla vs Cognitive OS traces across stack-diverse consumer fixture projects. It uses normalized real provider/harness usage shapes but does not call live providers, so it proves measurement portability rather than live causal savings.",
        "",
        "| Stack | Provider | Harness | Baseline tokens | COS tokens | Saved | Reduction |",
        "|---|---|---|---:|---:|---:|---:|",
    ]
    for row in payload["results"]:
        lines.append(
            f"| {row['stack']} | {row['provider']} | {row['harness']} | {row['baseline_total_tokens']} | {row['cos_total_tokens']} | {row['saved_tokens']} | {row['reduction_percent']}% |"
        )
    lines.extend([
        "",
        "## Claim boundary",
        "",
        "Evidence: normalized parser and reporting paths accept OpenAI/Codex, Anthropic/OpenCode, and generic IDE token usage shapes across Node, Python, and Go consumer fixtures.",
        "",
        "Inference boundary: live savings still require paired real task runs from the target harness/provider. This smoke blocks parser/projection regressions, not provider economics.",
        "",
    ])
    return "\n".join(lines)


def run_smoke(*, threshold_percent: float) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="cos-token-consumer-smoke-") as raw_tmp:
        tmp = Path(raw_tmp)
        results = [_result_for(stack, tmp) for stack in STACKS]
    status = "pass" if all(row.reduction_percent >= threshold_percent and row.saved_tokens > 0 for row in results) else "fail"
    return {
        "schema_version": 1,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "status": status,
        "threshold_percent": threshold_percent,
        "project_stack_count": len(results),
        "telemetry_schema": "token-usage-normalized.v1",
        "results": [asdict(row) for row in results],
        "claim_boundary": {
            "evidence": "stack-diverse consumer fixtures with normalized provider/harness usage shapes",
            "inference": "does not call live providers and does not prove live causal savings",
        },
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--threshold-percent", type=float, default=20.0)
    parser.add_argument("--archive", type=Path, default=DEFAULT_ARCHIVE)
    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
    parser.add_argument("--reset", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    payload = run_smoke(threshold_percent=args.threshold_percent)
    args.archive.parent.mkdir(parents=True, exist_ok=True)
    if args.reset and args.archive.exists():
        args.archive.unlink()
    with args.archive.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(payload, sort_keys=True) + "\n")
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(_render_report(payload), encoding="utf-8")
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(str(args.report))
    return 0 if payload["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
